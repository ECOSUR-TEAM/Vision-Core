# Frigate local desde Python en el host. Para producción: host y stream remotos.
# El override docker-compose.webcam.yml usa frigate:8554 dentro de Docker.
VISION_CORE_RTSP_URL=rtsp://127.0.0.1:28554/entrada
FRIGATE_WEBCAM_DEVICE=/dev/video0
VISION_CORE_OPEN_TIMEOUT_MS=5000
VISION_CORE_READ_TIMEOUT_MS=5000
VISION_CORE_RECONNECT_ATTEMPTS=5
VISION_CORE_RECONNECT_DELAY_SECONDS=2
# Opciones globales de OpenCV/FFmpeg; TCP evita depender de puertos RTP UDP.
OPENCV_FFMPEG_CAPTURE_OPTIONS='rtsp_transport;tcp'
# Crear a partir del frame real; zones.example.json NO es una calibración.
VISION_CORE_ZONES_FILE=config/zones.json
VISION_CORE_ZONE_CONFIRMATION_FRAMES=3
VISION_CORE_EMBEDDING_MODEL=mobilenet_v3_small
# CPU para la primera instalación. Omitir para selección automática o usar cuda.
VISION_CORE_EMBEDDING_DEVICE=cpu
# Solo monitor web: 1 activa zonas ilustrativas 640x480; 0 exige calibración real.
VISION_CORE_MONITOR_DEMO_ZONES=0
