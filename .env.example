# Arranque diario: docker compose up. URL siguiente solo para Python en el host.
# Compose conecta Vision Core al servicio frigate:8554 automáticamente.
VISION_CORE_RTSP_URL=rtsp://127.0.0.1:28554/entrada
FRIGATE_WEBCAM_DEVICE=/dev/video0
VISION_CORE_OPEN_TIMEOUT_MS=5000
VISION_CORE_READ_TIMEOUT_MS=5000
# Un hilo evita la cola de frames del decodificador. 0 = selección automática.
VISION_CORE_DECODER_THREADS=1
VISION_CORE_RECONNECT_ATTEMPTS=5
VISION_CORE_RECONNECT_DELAY_SECONDS=2
# Opciones globales de OpenCV/FFmpeg; TCP evita depender de puertos RTP UDP.
OPENCV_FFMPEG_CAPTURE_OPTIONS='rtsp_transport;tcp'
# Crear a partir del frame real; zones.example.json NO es una calibración.
VISION_CORE_ZONES_FILE=config/zones.json
VISION_CORE_ZONE_CONFIRMATION_FRAMES=3
VISION_CORE_EMBEDDING_MODEL=mobilenet_v3_small
# CPU para la primera instalación. Omitir para selección automática o usar cuda.
VISION_CORE_EMBEDDING_DEVICE=cpu
# Solo monitor web: 1 activa zonas ilustrativas 640x480; 0 exige calibración real.
VISION_CORE_MONITOR_DEMO_ZONES=0
# Dirección de escucha del monitor dentro del contenedor (publica el puerto 8080).
VISION_CORE_MONITOR_HOST=0.0.0.0
# 0 recuerda durante esta ejecución; el control de reuniones se añadirá después.
VISION_CORE_REID_TTL_SECONDS=0
VISION_CORE_REID_THRESHOLD=0.85
# Completar con la IP/ruta comprobadas de la cámara Ethernet; no versionar claves.
FRIGATE_CAMERA_RTSP_URL='rtsp://192.168.50.72:554/live.sdp'
# Compose: 1 hasta calibrar; después 0 y VISION_CORE_ZONES_FILE=config/zones.json.
VISION_CORE_MONITOR_UNCALIBRATED=1
# Persistencia local: se activa al definir DB_PATH; 0 la desactiva explícitamente.
VISION_CORE_DB_ENABLED=1
VISION_CORE_DB_PATH=/app/data/vision-core.sqlite3
# 1: si falla la DB, el pipeline sigue en memoria y health() lo informa.
VISION_CORE_DB_FAIL_OPEN=1
VISION_CORE_DB_BUSY_TIMEOUT_SECONDS=5
# TTLs en segundos; 0 desactiva el borrado por tiempo de ese tipo.
VISION_CORE_EVENT_TTL_SECONDS=2592000
VISION_CORE_HISTORY_TTL_SECONDS=604800
VISION_CORE_IDENTITY_TTL_SECONDS=86400
VISION_CORE_TRACK_TTL_SECONDS=86400
VISION_CORE_SESSION_TTL_SECONDS=2592000
VISION_CORE_METRICS_TTL_SECONDS=2592000
VISION_CORE_DB_PRUNE_INTERVAL_SECONDS=3600
# Solo para un futuro PostgreSQL; NUNCA versionar contraseñas aquí.
# VISION_CORE_DB_URL=postgresql://...
# VISION_CORE_DB_PASSWORD=
