# Copia a .env y exporta las variables al ejecutar Python fuera de Docker.
# Arranque diario: docker compose up (video sintético). Para cámara: --profile camera.
# En perfil camera, Vision Core usa frigate:8554; la URL RTSP de abajo es para Python en el host.
# Valores con ejemplos no contienen secretos ni credenciales reales.

# Video / RTSP
VISION_CORE_VIDEO_SOURCE=rtsp
VISION_CORE_RTSP_URL=rtsp://127.0.0.1:28554/entrada
VISION_CORE_VIDEO_PATH=
VISION_CORE_RTSP_TRANSPORT=tcp
VISION_CORE_OPEN_TIMEOUT_MS=5000
VISION_CORE_READ_TIMEOUT_MS=5000
VISION_CORE_RECONNECT_ATTEMPTS=5
VISION_CORE_RECONNECT_DELAY_SECONDS=2
VISION_CORE_DECODER_THREADS=1
OPENCV_FFMPEG_CAPTURE_OPTIONS="rtsp_transport;tcp"

# Deteccion
# VISION_CORE_MODEL_PATH=yolov8n.pt  # pesos no versionados (*.pt en .gitignore); valor por defecto: yolov8n.pt
VISION_CORE_DETECTION_DEVICE=cpu
VISION_CORE_DETECTION_CONFIDENCE=0.5
VISION_CORE_DETECTION_CLASSES=0
VISION_CORE_TRACKING_ENABLED=1
VISION_CORE_TRACK_MAX_MISSED_FRAMES=30

# ReID
VISION_CORE_EMBEDDING_MODEL=mobilenet_v3_small
VISION_CORE_EMBEDDING_DEVICE=cpu
VISION_CORE_REID_THRESHOLD=0.85
VISION_CORE_REID_AMBIGUITY_MARGIN=0.03
VISION_CORE_REID_TTL_SECONDS=0
VISION_CORE_REID_GALLERY_SIZE=8

# Zonas y puerta
VISION_CORE_ZONES_FILE=
VISION_CORE_ZONE_CONFIRMATION_FRAMES=3
VISION_CORE_MONITOR_DEMO_ZONES=0
# 1 hasta calibrar; después 0 con VISION_CORE_ZONES_FILE=config/zones.json.
VISION_CORE_MONITOR_UNCALIBRATED=1
# Persistencia local SQLite: no requiere usuario ni contraseña.
# Se activa al definir DB_PATH; 0 la desactiva explícitamente.
VISION_CORE_DB_ENABLED=1
VISION_CORE_DB_PATH=/app/data/vision-core.sqlite3
# 1: si falla la DB, el pipeline sigue en memoria y health() lo informa.
VISION_CORE_DB_FAIL_OPEN=1
VISION_CORE_DB_BUSY_TIMEOUT_SECONDS=5
# TTLs en segundos; 0 desactiva el borrado por tiempo de ese tipo.
VISION_CORE_EVENT_TTL_SECONDS=2592000
VISION_CORE_HISTORY_TTL_SECONDS=604800
VISION_CORE_IDENTITY_TTL_SECONDS=86400
VISION_CORE_TRACK_TTL_SECONDS=86400
VISION_CORE_SESSION_TTL_SECONDS=2592000
VISION_CORE_METRICS_TTL_SECONDS=2592000
VISION_CORE_DB_PRUNE_INTERVAL_SECONDS=3600

# Monitor
VISION_CORE_MONITOR_HOST=0.0.0.0
VISION_CORE_MONITOR_PORT=8080
VISION_CORE_MONITOR_EXIT_ON_ERROR=1

# Logging y rendimiento
VISION_CORE_LOG_LEVEL=INFO
VISION_CORE_LOG_JSON=1
VISION_CORE_CAMERA_ID=camera-1
VISION_CORE_PERFORMANCE_INTERVAL_SECONDS=1.0
VISION_CORE_MINIMUM_FREE_DISK_MB=500
VISION_CORE_DISK_CHECK_PATH=/model-cache

# Puente de Frigate (sin credenciales reales)
FRIGATE_WEBCAM_DEVICE=/dev/video0
FRIGATE_CAMERA_RTSP_URL='rtsp://CAMERA_IP:554/live.sdp'
