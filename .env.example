# IP/hostname de Frigate y nombre EXACTO del stream configurado en go2rtc.
VISION_CORE_RTSP_URL=rtsp://192.168.1.100:8554/entrada
VISION_CORE_OPEN_TIMEOUT_MS=5000
VISION_CORE_READ_TIMEOUT_MS=5000
VISION_CORE_RECONNECT_ATTEMPTS=5
VISION_CORE_RECONNECT_DELAY_SECONDS=2
# Opciones globales de OpenCV/FFmpeg; TCP evita depender de puertos RTP UDP.
OPENCV_FFMPEG_CAPTURE_OPTIONS='rtsp_transport;tcp'
